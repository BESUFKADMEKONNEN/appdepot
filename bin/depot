#!/usr/bin/env bash
# ==============================================================================
# depot: AppDepot Unified CLI and Desktop Launcher (Native Rust + Live Scanner)
# ==============================================================================
set -euo pipefail

TARGET_FILE="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$TARGET_FILE")/.." && pwd)"
ROOT="/opt/Application"
NATIVE_BIN="$SCRIPT_DIR/target/debug/depot"

CMD="${1:-help}"

# If native Rust binary exists and is executable, delegate to it for CLI commands
if [ -x "$NATIVE_BIN" ] && [ "$CMD" != "gui" ]; then
  exec "$NATIVE_BIN" "$@"
fi

if [ "$CMD" = "gui" ]; then
  echo "Launching AppDepot Desktop GUI..."
  exec "$SCRIPT_DIR/start.sh"
fi

show_help() {
  cat << 'EOF'
AppDepot (depot) v0.1.0 - Windows' Program Files experience, done the Linux way.

USAGE:
    depot <COMMAND> [OPTIONS]

COMMANDS:
    init             Initialize install tree at /opt/Application with 2775 devtools
    list             List live installed applications and categories
    info <app>       Show detailed metadata, ledger artifacts, and health
    install <src>    Install an archive, .deb, or AppImage into a category
    remove <app>     Cleanly remove an application using its ledger
    doctor           Run live diagnostic checks on the host machine
    gui              Launch the interactive AppDepot desktop GUI
    help             Print this help menu
EOF
}

case "$CMD" in
  init)
    echo "=========================================================="
    echo "  AppDepot - Initializing Categorized System Tree"
    echo "=========================================================="
    echo "• Target Root: $ROOT"
    if [ -d "$ROOT" ]; then
      PERMS=$(stat -c "%a %G" "$ROOT" 2>/dev/null || echo "unknown")
      echo "✓ $ROOT already exists with permissions: $PERMS"
    else
      echo "Creating $ROOT..."
    fi
    ;;

  list)
    echo "========================================================================"
    echo "  AppDepot Live Registry (/opt/Application)"
    echo "========================================================================"
    printf "%-12s %-22s %-10s %-30s\n" "CATEGORY" "APPLICATION" "MODE" "PHYSICAL PATH"
    echo "------------------------------------------------------------------------"
    if [ -d "$ROOT" ]; then
      for cat_dir in "$ROOT"/*; do
        if [ -d "$cat_dir" ]; then
          cat_name=$(basename "$cat_dir")
          for item in "$cat_dir"/*; do
            if [ -e "$item" ] || [ -L "$item" ]; then
              item_name=$(basename "$item")
              if [ -L "$item" ]; then
                mode="linked"
                target=$(readlink "$item" || echo "unknown")
              else
                mode="managed"
                target="$item"
              fi
              printf "%-12s %-22s %-10s %-30s\n" "$cat_name" "$item_name" "$mode" "$target"
            fi
          done
        fi
      done
    else
      echo "Root $ROOT does not exist. Run 'depot init' first."
    fi
    echo "------------------------------------------------------------------------"
    ;;

  info)
    APP="${2:-antigravity}"
    FOUND=0
    if [ -d "$ROOT" ]; then
      for cat_dir in "$ROOT"/*; do
        if [ -d "$cat_dir" ]; then
          cat_name=$(basename "$cat_dir")
          if [ -e "$cat_dir/$APP" ] || [ -L "$cat_dir/$APP" ]; then
            FOUND=1
            if [ -L "$cat_dir/$APP" ]; then
              MODE="linked"
              TARGET=$(readlink "$cat_dir/$APP")
            else
              MODE="managed"
              TARGET="$cat_dir/$APP"
            fi
            echo "Application: $APP"
            echo "--------------------------------------------------------"
            echo "• Category:        $cat_name"
            echo "• Ownership Mode:  $MODE"
            echo "• Target Path:     $TARGET"
            if [ -f "$TARGET/chrome-sandbox" ]; then
              SB_PERMS=$(stat -c "%a %U" "$TARGET/chrome-sandbox")
              echo "• Sandbox Helper:  Found chrome-sandbox ($SB_PERMS)"
            fi
            if [ -L "/usr/local/bin/$APP" ]; then
              echo "• Command Link:    /usr/local/bin/$APP -> $(readlink /usr/local/bin/$APP)"
            fi
            if [ -f "/usr/share/applications/$APP.desktop" ]; then
              echo "• Desktop Entry:   /usr/share/applications/$APP.desktop"
            fi
            break
          fi
        fi
      done
    fi
    if [ "$FOUND" -eq 0 ]; then
      echo "Application '$APP' not found in $ROOT."
    fi
    ;;

  doctor)
    echo "Running Live AppDepot Doctor Diagnostics on Host Machine..."
    echo "------------------------------------------------------------------------"
    # D-001
    if [ -d "$ROOT" ]; then
      STAT=$(stat -c "%a %G" "$ROOT")
      echo "  [✓] D-001: Install root ($ROOT) exists. Mode & Group: $STAT"
    else
      echo "  [✗] D-001: Install root ($ROOT) does not exist."
    fi

    # D-003
    DANGLING=0
    if [ -d "/usr/local/bin" ]; then
      for link in /usr/local/bin/*; do
        if [ -L "$link" ] && [ ! -e "$link" ]; then
          echo "  [✗] D-003: Dangling symlink: $link"
          DANGLING=1
        fi
      done
      if [ "$DANGLING" -eq 0 ]; then
        echo "  [✓] D-003: All symlinks in /usr/local/bin point to valid targets."
      fi
    fi

    # D-006
    if [ -f "/opt/Application/ide/antigravity/chrome-sandbox" ]; then
      SB_STAT=$(stat -c "%a %U" "/opt/Application/ide/antigravity/chrome-sandbox")
      if [ "$SB_STAT" = "4755 root" ]; then
        echo "  [✓] D-006: Antigravity chrome-sandbox has mode 4755 root setuid."
      else
        echo "  [!] D-006: Antigravity chrome-sandbox has mode $SB_STAT (needs 4755 root)."
      fi
    fi

    # D-007
    if [ -f "/etc/profile.d/appdepot.sh" ]; then
      echo "  [✓] D-007: Modular environment loader /etc/profile.d/appdepot.sh exists."
    else
      echo "  [!] D-007: /etc/profile.d/appdepot.sh environment loader is missing."
    fi
    ;;

  help|--help|-h)
    show_help
    ;;

  *)
    echo "Unknown command: $CMD"
    show_help
    exit 1
    ;;
esac
